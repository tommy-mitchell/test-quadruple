{
	"name": "test-quadruple",
	"version": "1.0.0",
	"description": "Simple and declarative mocks, spies, and replacements.",
	"license": "MIT",
	"repository": "tommy-mitchell/test-quadruple",
	"author": "Tommy Mitchell (https://tommymitchell.io)",
	"type": "module",
	"exports": {
		"types": "./dist/index.d.ts",
		"default": "./dist/index.js"
	},
	"imports": {
		"#src/*.ts": "./src/*.ts",
		"#fixtures/*": "./test/fixtures/*/fixture.ts",
		"#mrowki": "mrowki",
		"#baz": "./test/fixtures/imports/nested/baz.ts"
	},
	"sideEffects": false,
	"engines": {
		"node": "^22.22 || ^24.15 || >=26"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "run-all 'dprint check' xo",
		"format": "dprint fmt && xo --fix",
		"test": "c8 ava && tsd test-d"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"nodejs",
		"mock",
		"mocking",
		"test",
		"testing",
		"unit",
		"unit-test",
		"tdd",
		"stub",
		"spy",
		"faking",
		"fakes",
		"replace",
		"replacements",
		"substitute",
		"testdouble",
		"testtriple",
		"sinon",
		"esmock"
	],
	"dependencies": {
		"esmock": "^2.8.0",
		"map-obj": "^7.0.0"
	},
	"devDependencies": {
		"@tommy-mitchell/configs": "^0.5.0",
		"@tommy-mitchell/test-helpers": "^0.2.0",
		"@types/node": "^22.20",
		"ava": "^8.1.2",
		"c8": "^12.0.0",
		"dprint": "^0.64.3",
		"mrowki": "^0.1.1",
		"run-all-cli": "^0.1.0",
		"ts-pattern": "^5.9.2",
		"tsd": "^0.33.0",
		"tsdown": "^0.23.2",
		"type-fest": "^5.10.0",
		"typescript": "~6.0.3",
		"xo": "^5.0.1"
	},
	"ava": {
		"extensions": [
			"ts"
		]
	}
}
