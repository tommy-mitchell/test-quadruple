{
	"name": "test-quadruple",
	"version": "1.0.0",
	"description": "Simple and declarative mocks, spies, and replacements.",
	"license": "MIT",
	"repository": "tommy-mitchell/test-quadruple",
	"author": "Tommy Mitchell (https://tommymitchell.io)",
	"type": "module",
	"exports": {
		"types": "./dist/index.d.ts",
		"default": "./dist/index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": "^22.22 || ^24.15 || >=26"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsdown",
		"lint": "xo",
		"format": "dprint fmt && xo --fix",
		"test": "c8 ava && npm run test:types",
		"test:types": "npm run build && tsd -t dist/index.d.ts"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"nodejs",
		"mock",
		"mocking",
		"test",
		"testing",
		"unit",
		"unit-test",
		"tdd",
		"stub",
		"spy",
		"faking",
		"fakes",
		"replace",
		"replacements",
		"substitute",
		"testdouble",
		"testtriple",
		"sinon",
		"esmock"
	],
	"dependencies": {
		"esmock": "^2.7.6",
		"map-obj": "^6.0.0"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "^7.59.3",
		"@tommy-mitchell/dprint-config": "^0.8.0",
		"@tommy-mitchell/eslint-config-xo": "^2.0.0-beta.10",
		"@tommy-mitchell/tsconfig": "^4.0.0",
		"@types/node": "^22.20",
		"ava": "^8.0.1",
		"c8": "^12.0.0",
		"dprint": "^0.58.0",
		"meow": "^14.1.0",
		"strip-comments-js": "^1.4.0",
		"ts-pattern": "^5.9.0",
		"tsd": "^0.33.0",
		"tsdown": "^0.22.14",
		"type-fest": "^5.10.0",
		"typescript": "~6.0.3",
		"xo": "^5.0.1"
	},
	"ava": {
		"extensions": [
			"ts"
		]
	}
}
